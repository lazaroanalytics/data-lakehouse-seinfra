# ==============================================
# DATA LAKEHOUSE
# ==============================================

# Ignora todos os arquivos dentro de data
data/**

# Permite que o Git percorra todos os diretórios
!data/**/

# Permite .gitkeep em qualquer nível
!data/**/.gitkeep

# ==============================================
# METADATA - arquivos permitidos no repositorio
# ==============================================

!data/metadata/
!data/metadata/dim_delegatarias_template.xlsx
!data/metadata/README.md

# Formatos de dados e planilhas geradas
*.parquet
*.pqt
*.feather

# ==============================================
# OFFICE / EXCEL TEMPORARY LOCK FILES
# ==============================================
~$*
~$*.xlsx
~$*.csv
*.tmp
*.temp

# ==============================================
# OS GENERATED FILES
# ==============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================
# PYTHON / CACHE / ENVS / IDES
# ==============================================
__pycache__/
*.py[codz]
*$py.class
*.so

.env
.envrc
.venv
env/
venv/
ENV/

.vscode/
.idea/
tempCodeRunnerFile.py

.pytest_cache/
.coverage
*.log