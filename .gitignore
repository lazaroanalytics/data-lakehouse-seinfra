# Ignora toda a pasta data (dados operacionais, SGTI, BMI, etc.)
data/*
!data/.gitkeep

# Permite subir APENAS o template e a documentação na pasta metadata
!data/metadata/
!data/metadata/dim_delegatarias_template.xlsx
!data/metadata/README.md

# Formatos de dados e planilhas geradas
*.parquet
*.pqt
*.feather

# ==============================================
# OFFICE / EXCEL TEMPORARY LOCK FILES
# ==============================================
~$*
~$*.xlsx
~$*.csv
*.tmp
*.temp

# ==============================================
# OS GENERATED FILES
# ==============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

